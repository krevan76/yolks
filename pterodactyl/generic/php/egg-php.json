    "scripts": {
        "installation": {
            "script": "#!\/bin\/bash\r\n\r\nmkdir -p \/mnt\/server\r\ncd \/mnt\/server\r\n\r\nif [ -z \"${GIT_ADDRESS}\" ]; then\r\n    echo -e \"no git repo set, upload your files and start the server\"\r\n    exit 0\r\nfi\r\n\r\nif [ \"$(ls -A \/mnt\/server)\" ] && [ -d .git ]; then\r\n    git pull\r\nelif [ -z \"${BRANCH}\" ]; then\r\n    git clone ${GIT_ADDRESS} .\r\nelse\r\n    git clone --single-branch --branch ${BRANCH} ${GIT_ADDRESS} .\r\nfi\r\n",
            "container": "ghcr.io\/krevan76\/installers:debian",
            "entrypoint": "bash"
        }
    },
